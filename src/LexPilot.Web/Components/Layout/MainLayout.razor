@using LexPilot.Web.Components.Copilot
@inherits LayoutComponentBase

<div class="lex-shell">
    <aside class="lex-sidebar">
        <div class="brand">
            <div class="brand-logo">LP</div>
            <div>
                <div class="brand-title">LexPilot AI</div>
                <div class="brand-subtitle">Cabinet intelligent</div>
            </div>
        </div>

        <nav class="menu">
            <a class="active" href="/">🏠 Tableau de bord</a>
            <a href="/clients">👥 Clients</a>
            <a href="/dossiers">⚖️ Dossiers</a>
            <a href="/documents">📄 Documents</a>
            <a href="/mails">📧 Outlook</a>
            <a href="/agenda">📅 Agenda</a>
            <a href="/facturation">💰 Facturation</a>
            <a href="/parametres">⚙️ Paramètres</a>
        </nav>
    </aside>

    <main class="lex-main">
        <header class="topbar">
            <div>
                <h1>LexPilot AI</h1>
                <p>Votre collaborateur numérique pour cabinet d'avocats</p>
            </div>
            <input class="search" placeholder="Rechercher client, dossier, document..." />
        </header>

        <section class="content">
            @Body
        </section>
    </main>

    <aside class="ai-panel">
        <CopilotPanel />
    </aside>
</div>

